auto-install-peers=true

# Never let an ambient NODE_ENV=production silently prune this workspace's
# devDependencies. pnpm treats NODE_ENV=production as an implicit `--prod`, so a
# plain `pnpm install` in any image that inherits NODE_ENV=production (the
# paperclip-runtime base sets it, and the agent toolchain image inherits it)
# exits 0 while skipping every devDependency -- leaving no vitest, typescript,
# esbuild or tsx, so no test/typecheck/build entrypoint can run. See BLO-19064.
#
# `production=false` is the key that overrides NODE_ENV; the `prod=false` alias
# does NOT. An explicit `--prod` on the command line still wins over this, so
# deliberate production installs are unaffected.
production=false
