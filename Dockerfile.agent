# syntax=harbor.blockcast.net/dockerfile/dockerfile:1.20
# Per-commit agent overlay. The expensive language/container/FFmpeg toolchain
# lives in TOOLCHAIN_IMAGE and is rebuilt only when its content-derived tag
# changes; this file adds the matching server artifacts.

ARG SERVER_IMAGE=harbor.blockcast.net/paperclip/paperclip:latest-k8s-vendored
ARG TOOLCHAIN_IMAGE=harbor.blockcast.net/paperclip-agent/paperclip-agent-toolchain:latest

FROM ${SERVER_IMAGE} AS server
FROM ${TOOLCHAIN_IMAGE}

USER root
COPY --chown=node:node --from=server /app /app
# Root-owned on purpose (PEN-3715). The five GitHub wrappers are one-line execs
# into the egress scrub runtimes that live in this tree, so a node-owned copy
# would let the agent — the adversary PEN-2527's threat model names — rewrite
# the scrubber in place. `--chown` covers the copied contents; the destination
# directory's own inode is kept root-owned by Dockerfile.runtime, which is the
# other half of the fix (a read-only file in a writable directory is still
# replaceable by rename(2)).
COPY --chown=root:root --from=server /opt/paperclip-bundled-adapters /opt/paperclip-bundled-adapters
COPY --from=server /usr/local/bin/github-mcp-server /usr/local/bin/github-mcp-server
# PEN-3713. Taken from the server image rather than re-copied from the build
# context so the two images cannot carry different wrapper bodies: one file in
# the repo, one install, one rule. Root-owned by default (no --chown), which
# is the whole point — uid 1000 must not be able to rewrite these.
COPY --from=server /usr/local/libexec/paperclip/bin /usr/local/libexec/paperclip/bin
# PEN-4932 stage 3b-i. Same provenance rule as the wrapper dir above: taken from
# the server image, never re-copied from the build context, so the two images
# cannot carry different bodies of the PEN-3156 pre-push guard. Root-owned by
# default (no `--chown`), which is the point. Inert until the runtime is
# repointed — see docker/github-hooks/README.md.
COPY --from=server /usr/local/libexec/paperclip/hooks /usr/local/libexec/paperclip/hooks
COPY --from=server /opt/penstock/bin/penstock-agent-runtime.mjs /opt/penstock/bin/penstock-agent-runtime.mjs
COPY --from=server /usr/local/bin/caveman-proxy /usr/local/bin/caveman-proxy
COPY --from=server /opt/penstock/ponytail /opt/penstock/ponytail
# PEN-4932. The server image asserts the same property, and this repeats it
# deliberately: that one proves the bake, this one proves the DELIVERY. These
# are different images from different bases, and every failure between them —
# a `--from` stage that resolved to an older server image, a path that drifted
# on one side only, a later layer shadowing the directory — lands here and is
# invisible there. This is the image agents actually run, so this is the copy
# whose absence would stop every push in the fleet at stage 3b-ii.
#
# Placed last rather than beside its COPY so it reads the image as shipped,
# after every other overlay layer has had its chance to clobber the path.
#
# See the server Dockerfile for why the test is `-perm -0005` rather than
# `test -x`, and why the existence check is separate from the find.
RUN set -eu; \
  hooks=/usr/local/libexec/paperclip/hooks; \
  test -f "$hooks/pre-push" || { echo "PEN-4932: $hooks/pre-push did not reach the agent image; the publish guard would refuse every push once the runtime is repointed" >&2; false; }; \
  offender="$(find "$hooks" \( ! -user root -o ! -perm -0005 -o -perm /022 \) -print -quit)"; \
  { test -z "$offender" || { echo "PEN-4932: delivered publish guard is not root-owned-and-world-runnable: $offender" >&2; false; }; }
USER node
