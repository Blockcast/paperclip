# syntax=harbor.blockcast.net/dockerfile/dockerfile:1.20
# Per-commit agent overlay. The expensive language/container/FFmpeg toolchain
# lives in TOOLCHAIN_IMAGE and is rebuilt only when its content-derived tag
# changes; this file adds the matching server artifacts.

ARG SERVER_IMAGE=harbor.blockcast.net/paperclip/paperclip:latest-k8s-vendored
ARG TOOLCHAIN_IMAGE=harbor.blockcast.net/paperclip-agent/paperclip-agent-toolchain:latest

FROM ${SERVER_IMAGE} AS server
FROM ${TOOLCHAIN_IMAGE}

USER root
COPY --chown=node:node --from=server /app /app
COPY --from=server /opt/paperclip-bundled-adapters /opt/paperclip-bundled-adapters
COPY --from=server /usr/local/bin/github-mcp-server /usr/local/bin/github-mcp-server
# PEN-3713. Taken from the server image rather than re-copied from the build
# context so the two images cannot carry different wrapper bodies: one file in
# the repo, one install, one rule. Root-owned by default (no --chown), which
# is the whole point — uid 1000 must not be able to rewrite these.
COPY --from=server /usr/local/libexec/paperclip/bin /usr/local/libexec/paperclip/bin
COPY --from=server /opt/penstock/bin/penstock-agent-runtime.mjs /opt/penstock/bin/penstock-agent-runtime.mjs
COPY --from=server /usr/local/bin/caveman-proxy /usr/local/bin/caveman-proxy
COPY --from=server /opt/penstock/ponytail /opt/penstock/ponytail
USER node
