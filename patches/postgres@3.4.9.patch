+    // expression evaluated that promise and threw the reference away, so the
+    // rejection could never reach a handler and surfaced as an
+    // unhandledRejection; Paperclip's process crash guard turns one of those
+    // into a deliberate worker exit, so a failed cancel dial took down every
+    // agent's in-flight dispatch. Returning it lets the caller attach a handler
+    // (see server/src/services/agent-start-lock-db.ts `cancelQuery`).
+    //
+    // The self-disarm is preserved exactly, including its order: the canceller
+    // is invoked first and nulled immediately after, so a second `cancel()` is
+    // still a no-op and returns undefined.
+    if (!this.canceller) return
+    const cancelled = this.canceller(this)
+    this.canceller = null
+    return cancelled
