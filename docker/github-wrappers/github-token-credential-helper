#!/bin/sh
[ "${1:-get}" = "get" ] || exit 0
INPUT="$(cat)"
# Require exact "protocol=https" and "host=github.com" lines,
# not substrings: git sends one key=value pair per line. A
# substring match on the raw blob would also match a line like
# "host=github.com.evil.example", handing that attacker-chosen
# host the merge-token PAT this override exists to gate. Pinning
# protocol=https as well keeps the token off plaintext HTTP,
# where an http://github.com/... remote could otherwise send it
# unencrypted before any redirect could protect it.
if ! printf '%s\n' "${INPUT}" | grep -Fxq 'protocol=https'; then
  exit 0
fi
if ! printf '%s\n' "${INPUT}" | grep -Fxq 'host=github.com'; then
  exit 0
fi
if [ "${GH_SEAT_TOKEN_VALUE+x}" = x ]; then
  TOKEN="${GH_SEAT_TOKEN_VALUE}"
  while :; do
    case "${TOKEN}" in
      [[:space:]]*) TOKEN="${TOKEN#?}" ;;
      *[[:space:]]) TOKEN="${TOKEN%?}" ;;
      *) break ;;
    esac
  done
  case "${TOKEN}" in
    "")
      echo "github-token-credential-helper: GH_SEAT_TOKEN_VALUE is set but holds only whitespace; refusing to run with ambient auth" >&2
      exit 1
      ;;
    *[[:space:]]*)
      echo "github-token-credential-helper: GH_SEAT_TOKEN_VALUE contains embedded whitespace; refusing to guess at the intended token" >&2
      exit 1
      ;;
  esac
  printf 'username=x-access-token\npassword=%s\n\n' "${TOKEN}"
  exit 0
fi
TOKEN_FILE="${PAPERCLIP_GITHUB_TOKEN_FILE:-/etc/paperclip/secrets/github-token/token}"
[ -r "${TOKEN_FILE}" ] || exit 0
TOKEN="$(tr -d '\r\n' < "${TOKEN_FILE}")"
[ -n "${TOKEN}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n\n' "${TOKEN}"
