#!/bin/sh
# Keep egress scrubbing at the last wrapper before the real GitHub
# CLI. /usr/bin/gh is itself the image-level token wrapper, so it
# still supplies the live App/seat token after this runtime has
# rewritten authored argv and file-backed bodies.
exec /usr/local/bin/node /opt/paperclip-bundled-adapters/node_modules/@paperclipai/adapter-utils/dist/github-cli-egress-runtime.js /usr/bin/gh "$@"
